{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.anthropic.com)",
      "Bash(xargs:*)",
      "Bash(open:*)",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "mcp__ide__getDiagnostics",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/load-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-completion.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Check if this bash command could: 1) restart the dev server (killing the in-memory ticket store), 2) force-push or reset --hard, 3) delete uncommitted work. If any risk, return 'deny' with reason. Otherwise 'approve'.",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
