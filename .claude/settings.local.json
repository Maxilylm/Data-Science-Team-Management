{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.anthropic.com)",
      "Bash(xargs:*)",
      "Bash(open:*)",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "mcp__ide__getDiagnostics",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/load-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-completion.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "ONLY deny if this bash command does one of these exact things: 1) 'git push --force' or 'git push -f' to main/master, 2) 'git reset --hard' on main/master, 3) 'rm -rf' on project directories. Approve everything else including branch deletion, stash operations, and normal git workflows. Return 'approve' unless it matches the exact patterns above.",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
